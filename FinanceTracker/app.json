{
  "expo": {
    "name": "Wavie",
    "slug": "wavie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wavie-logo.png",
    "scheme": "wavie",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Wavie uses the camera to photograph hoodies and your profile avatar.",
        "NSPhotoLibraryUsageDescription": "Wavie uses your photo library to upload hoodie photos and your profile avatar.",
        "NSFaceIDUsageDescription": "Wavie uses Face ID to protect studio actions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A10",
        "foregroundImage": "./assets/images/wavie-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/wavie-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0A10",
          "image": "./assets/images/wavie-logo.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
